<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="#F5F7FA">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Create Reservation"
        android:textSize="26sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/textBookingStation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Station"
        android:textSize="18sp"
        android:layout_marginTop="24dp" />

    <TextView
        android:id="@+id/textBookingTime"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Booking Time"
        android:textColor="#6C757D"
        android:layout_marginBottom="24dp" />

    <EditText
        android:id="@+id/editEnergyAmount"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Energy Amount (kWh)"
        android:inputType="numberDecimal"
        android:layout_marginBottom="18dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Transfer Type"
        android:textStyle="bold" />

    <Spinner
        android:id="@+id/spinnerTransferType"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp" />

    <Button
        android:id="@+id/buttonCreateReservation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Confirm Reservation" />

    <Button
        android:id="@+id/buttonCreateReservationBack"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Back"
        android:layout_marginTop="10dp" />

    <ProgressBar
        android:id="@+id/progressCreateReservation"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:visibility="gone"
        android:layout_marginTop="18dp" />

    <TextView
        android:id="@+id/textCreateReservationError"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="#B00020"
        android:gravity="center"
        android:layout_marginTop="18dp" />

</LinearLayout>