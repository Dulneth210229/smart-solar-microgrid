<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="#F5F7FA">

    <TextView
        android:id="@+id/textOperatorWelcome"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Welcome"
        android:textSize="26sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Grid Operator"
        android:textSize="16sp"
        android:textColor="#6C757D"
        android:layout_marginBottom="30dp" />

    <Button
        android:id="@+id/buttonScanQr"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Scan Transaction QR"
        android:layout_marginBottom="12dp" />

    <Button
        android:id="@+id/buttonOperatorReservations"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Pending Reservations"
        android:layout_marginBottom="12dp" />

    <Button
        android:id="@+id/buttonOperatorStations"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Stations"
        android:layout_marginBottom="24dp" />

    <Button
        android:id="@+id/buttonOperatorLogout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Logout" />

</LinearLayout>