<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F7FA">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Verify Transaction"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Scan the Prosumer's transaction QR"
            android:textColor="#6C757D"
            android:layout_marginBottom="24dp" />

        <Button
            android:id="@+id/buttonStartQrScan"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Scan QR Code" />

        <ProgressBar
            android:id="@+id/progressQrVerify"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="gone"
            android:layout_marginTop="20dp" />

        <TextView
            android:id="@+id/textQrVerifyError"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#B00020"
            android:gravity="center"
            android:layout_marginTop="15dp" />

        <LinearLayout
            android:id="@+id/layoutVerifiedReservation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:padding="18dp"
            android:visibility="gone"
            android:layout_marginTop="20dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="QR VERIFIED"
                android:textStyle="bold"
                android:textSize="20sp"
                android:textColor="#198754"
                android:gravity="center"
                android:layout_marginBottom="20dp" />

            <TextView
                android:id="@+id/textVerifiedProsumer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Prosumer" />

            <TextView
                android:id="@+id/textVerifiedStation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Station"
                android:layout_marginTop="8dp" />

            <TextView
                android:id="@+id/textVerifiedTime"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Time"
                android:layout_marginTop="8dp" />

            <TextView
                android:id="@+id/textVerifiedEnergy"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Energy"
                android:layout_marginTop="8dp" />

            <TextView
                android:id="@+id/textVerifiedType"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Transfer Type"
                android:layout_marginTop="8dp" />

            <TextView
                android:id="@+id/textVerifiedStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Status"
                android:textStyle="bold"
                android:layout_marginTop="8dp" />

            <Button
                android:id="@+id/buttonCompleteTransfer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Complete Energy Transfer"
                android:layout_marginTop="20dp" />

        </LinearLayout>

        <Button
            android:id="@+id/buttonQrScannerBack"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Back"
            android:layout_marginTop="20dp" />

    </LinearLayout>

</ScrollView>